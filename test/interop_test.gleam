pub fn interop_nested_empty_test() {
  let data = load_fixture("nested_empty.msgpack")
  let assert Ok(decoded) = unpack_exact(data)

  // {"empty_array": [], "empty_map": {}, "nested_empty": {"inner": []}}
  let assert Map(entries) = decoded
  list.length(entries) |> expect.to_equal(3)

  // Use find_entry helper (equality-based lookup) instead of dict/let assert
  find_entry(entries, String("empty_array")) |> expect.to_equal(Array([]))
  find_entry(entries, String("empty_map")) |> expect.to_equal(Map([]))

  let assert Map(inner_entries) = find_entry(entries, String("nested_empty"))
  find_entry(inner_entries, String("inner")) |> expect.to_equal(Array([]))
}


// ============================================================================
// Mixed-Type Tests
// ============================================================================

pub fn interop_mixed_array_test() {
  let data = load_fixture("mixed_array.msgpack")
  let assert Ok(Array(items)) = unpack_exact(data)

  // [nil, true, false, 42, -1, 3.14, "hello", binary(0xdead), [1,2], {"a":1}]
  list.length(items) |> expect.to_equal(10)

  // Verify each element with expect.to_equal
  let assert [v0, v1, v2, v3, v4, v5, v6, v7, v8, v9] = items
  v0 |> expect.to_equal(Nil)
  v1 |> expect.to_equal(Boolean(True))
  v2 |> expect.to_equal(Boolean(False))
  v3 |> expect.to_equal(Integer(42))
  v4 |> expect.to_equal(Integer(-1))
  // Float: check it decoded to Float type, then compare value
  let assert Float(f) = v5
  let assert True = float_close(f, 3.14, 0.0001)
  v6 |> expect.to_equal(String("hello"))
  v7 |> expect.to_equal(Binary(<<0xde, 0xad>>))
  v8 |> expect.to_equal(Array([Integer(1), Integer(2)]))
  v9 |> expect.to_equal(Map([#(String("a"), Integer(1))]))
}

pub fn interop_int_key_map_test() {
  let data = load_fixture("mixed_int_key_map.msgpack")
  let assert Ok(Map(entries)) = unpack_exact(data)

  // {1: "one", 2: "two", 3: "three"}
  let expected = [
    #(Integer(1), String("one")),
    #(Integer(2), String("two")),
    #(Integer(3), String("three")),
  ]
  entries |> expect.to_equal(expected)
}

pub fn interop_mixed_key_map_test() {
  let data = load_fixture("mixed_key_map.msgpack")
  let assert Ok(Map(entries)) = unpack_exact(data)

  // {true: "bool_key", "str": "string_key", 42: "int_key"}
  list.length(entries) |> expect.to_equal(3)

  find_entry(entries, Boolean(True)) |> expect.to_equal(String("bool_key"))
  find_entry(entries, String("str")) |> expect.to_equal(String("string_key"))
  find_entry(entries, Integer(42)) |> expect.to_equal(String("int_key"))
}

// ============================================================================
// Timestamp Tests
// ============================================================================

pub fn interop_timestamp32_test() {
  let data = load_fixture("timestamp32.msgpack")
  let assert Ok(decoded) = unpack_exact(data)

  let assert Ok(ts) = msgpack_timestamp.decode(decoded)
  let #(seconds, nanoseconds) = timestamp.to_unix_seconds_and_nanoseconds(ts)
  seconds |> expect.to_equal(1_234_567_890)
  nanoseconds |> expect.to_equal(0)

  // Round-trip
  let re_encoded_value = msgpack_timestamp.encode(ts)
  let assert Ok(re_encoded_bytes) = pack(re_encoded_value)
  re_encoded_bytes |> expect.to_equal(data)
}


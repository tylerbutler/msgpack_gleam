/// Cross-language interoperability tests using fixtures generated by
/// Python's msgpack library. Verifies wire-format compatibility by
/// decoding binary fixtures and comparing against expected values,
/// then re-encoding and comparing bytes (round-trip).
import gleam/bit_array
import gleam/dict.{type Dict}
import gleam/dynamic.{type Dynamic}
import gleam/dynamic/decode
import gleam/int
import gleam/json
import gleam/list
import gleam/string
import gleam/time/timestamp
import msgpack_gleam.{pack, unpack, unpack_exact}
import msgpack_gleam/timestamp as msgpack_timestamp
import msgpack_gleam/value.{
  Array, Binary, Boolean, Float, Integer, Map, Nil, String,
}
import simplifile
import startest
import startest/expect
import test_helpers

pub fn main() {
  startest.run(startest.default_config())
}

const interop_dir = "test/test_data/interop/"

// ============================================================================
// Helpers
// ============================================================================

fn load_fixture(filename: String) -> BitArray {
  let path = interop_dir <> filename
  let assert Ok(data) = simplifile.read_bits(path)
  data
}

fn load_manifest() -> Dict(String, Dynamic) {
  let assert Ok(content) = simplifile.read(interop_dir <> "manifest.json")
  let assert Ok(manifest) =
    json.parse(content, decode.dict(decode.string, decode.dynamic))
  manifest
}

fn get_fixtures(
  manifest: Dict(String, Dynamic),
  category: String,
) -> List(Dict(String, Dynamic)) {
  let assert Ok(fixtures_dyn) = dict.get(manifest, "fixtures")
  let assert Ok(categories) =
    decode.run(fixtures_dyn, decode.dict(decode.string, decode.dynamic))
  let assert Ok(cat_dyn) = dict.get(categories, category)
  let assert Ok(fixtures) =
    decode.run(cat_dyn, decode.list(decode.dict(decode.string, decode.dynamic)))
  fixtures
}

fn get_string_field(fixture: Dict(String, Dynamic), key: String) -> String {
  let assert Ok(v) = dict.get(fixture, key)
  let assert Ok(s) = decode.run(v, decode.string)
  s
}

/// Find a map entry by key using equality comparison
fn find_entry(
  entries: List(#(value.Value, value.Value)),
  key: value.Value,
) -> value.Value {
  let assert Ok(#(_, v)) =
    list.find(entries, fn(pair) {
      let #(k, _) = pair
      k == key
    })
  v
}

// ============================================================================
// Integer Boundary Tests
// ============================================================================

pub fn interop_integer_boundaries_test() {
  let manifest = load_manifest()
  let fixtures = get_fixtures(manifest, "integer-boundaries")

  list.each(fixtures, fn(fixture) {
    let filename = get_string_field(fixture, "file")
    let description = get_string_field(fixture, "description")
    let data = load_fixture(filename)

    let expected = case dict.get(fixture, "number") {
      Ok(v) -> {
        let assert Ok(n) = decode.run(v, decode.int)
        n
      }
      Error(_) -> {
        let assert Ok(v) = dict.get(fixture, "bignum")
        let assert Ok(s) = decode.run(v, decode.string)
        let assert Ok(n) = int.parse(s)
        n
      }
    }

    // Decode the fixture
    let result = unpack_exact(data)
    case result {
      Ok(Integer(n)) -> {
        case n == expected {
          True -> Nil
          False ->
            panic as {
              "Integer mismatch for "
              <> description
              <> ": expected "
              <> int.to_string(expected)
              <> ", got "
              <> int.to_string(n)
            }
        }
      }
      Ok(other) ->
        panic as {
          "Expected Integer for "
          <> description
          <> ", got "
          <> value.type_name(other)
        }
      Error(e) ->
        panic as {
          "Decode failed for " <> description <> ": " <> string.inspect(e)
        }
    }

    // Round-trip: re-encode and compare bytes
    let assert Ok(re_encoded) = pack(Integer(expected))
    case re_encoded == data {
      True -> Nil
      False ->
        panic as {
          "Round-trip mismatch for "
          <> description
          <> ": original="
          <> test_helpers.bits_to_hex(data)
          <> ", re-encoded="
          <> test_helpers.bits_to_hex(re_encoded)
        }
    }
  })
}

// ============================================================================
// Nested Structure Tests
// ============================================================================

pub fn interop_nested_map_array_map_test() {
  let data = load_fixture("nested_map_array_map.msgpack")
  let assert Ok(decoded) = unpack_exact(data)

  let expected =
    Map([
      #(
        String("users"),
        Array([
          Map([
            #(String("name"), String("Alice")),
            #(String("scores"), Array([Integer(95), Integer(87), Integer(92)])),
          ]),
          Map([
            #(String("name"), String("Bob")),
            #(String("scores"), Array([Integer(88), Integer(91), Integer(85)])),
          ]),
        ]),
      ),
    ])

  decoded |> expect.to_equal(expected)

  // Round-trip
  let assert Ok(re_encoded) = pack(expected)
  let assert Ok(re_decoded) = unpack_exact(re_encoded)
  re_decoded |> expect.to_equal(expected)
}


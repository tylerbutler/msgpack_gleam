// ============================================================================
// Streaming Decode Tests (multiple concatenated values)
// ============================================================================

pub fn interop_stream_three_values_test() {
  let data = load_fixture("stream_three_values.msgpack")

  // Decode first value: Integer(42)
  let assert Ok(#(v1, rest1)) = unpack(data)
  v1 |> expect.to_equal(Integer(42))

  // Decode second value: String("hello")
  let assert Ok(#(v2, rest2)) = unpack(rest1)
  v2 |> expect.to_equal(String("hello"))

  // Decode third value: Boolean(True)
  let assert Ok(#(v3, rest3)) = unpack(rest2)
  v3 |> expect.to_equal(Boolean(True))

  // No remaining bytes
  bit_array.byte_size(rest3) |> expect.to_equal(0)
}

pub fn interop_stream_five_values_test() {
  let data = load_fixture("stream_five_values.msgpack")

  let assert Ok(#(v1, rest1)) = unpack(data)
  v1 |> expect.to_equal(Nil)

  let assert Ok(#(v2, rest2)) = unpack(rest1)
  v2 |> expect.to_equal(Integer(255))

  let assert Ok(#(v3, rest3)) = unpack(rest2)
  v3 |> expect.to_equal(String("test"))

  let assert Ok(#(v4, rest4)) = unpack(rest3)
  v4 |> expect.to_equal(Array([Integer(1), Integer(2), Integer(3)]))

  let assert Ok(#(v5, rest5)) = unpack(rest4)
  v5 |> expect.to_equal(Map([#(String("key"), String("val"))]))

  // No remaining bytes
  bit_array.byte_size(rest5) |> expect.to_equal(0)
}

// ============================================================================
// Cross-implementation round-trip: encode in Gleam, verify bytes match Python
// ============================================================================

pub fn interop_roundtrip_all_integers_test() {
  let manifest = load_manifest()
  let fixtures = get_fixtures(manifest, "integer-boundaries")

  list.each(fixtures, fn(fixture) {
    let filename = get_string_field(fixture, "file")
    let expected_hex = get_string_field(fixture, "msgpack_hex")
    let reference_bytes = load_fixture(filename)

    let expected = case dict.get(fixture, "number") {
      Ok(v) -> {
        let assert Ok(n) = decode.run(v, decode.int)
        n
      }
      Error(_) -> {
        let assert Ok(v) = dict.get(fixture, "bignum")
        let assert Ok(s) = decode.run(v, decode.string)
        let assert Ok(n) = int.parse(s)
        n
      }
    }

    // Encode with Gleam
    let assert Ok(gleam_bytes) = pack(Integer(expected))

    // Compare hex representations for better error messages
    let gleam_hex = test_helpers.bits_to_hex(gleam_bytes)
    case gleam_hex == expected_hex {
      True -> Nil
      False ->
        panic as {
          "Encoding mismatch for "
          <> filename
          <> ": python="
          <> expected_hex
          <> ", gleam="
          <> gleam_hex
        }
    }

    gleam_bytes |> expect.to_equal(reference_bytes)
  })
}

// ============================================================================
// Helpers
// ============================================================================

fn float_close(a: Float, b: Float, tolerance: Float) -> Bool {
  let diff = case a -. b {
    d if d <. 0.0 -> 0.0 -. d
    d -> d
  }
  diff <. tolerance
}
